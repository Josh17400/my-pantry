# Copy to apps/web/.env and fill in after creating a Supabase project.
# Never commit real values — .env is gitignored.
#
# Both values are safe to ship in the client bundle: the anon key is public by
# design and access is controlled by Postgres row-level security, not secrecy.
#
# NEVER add the Supabase service_role (a.k.a. "secret") key here or anywhere in
# apps/. It bypasses row-level security entirely, and any VITE_-prefixed value
# is compiled into the shipped bundle where anyone can read it. Server-side
# secrets belong in Supabase Edge Function secrets only.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
